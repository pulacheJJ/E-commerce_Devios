APP_NAME=DEVIOZ
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
FORCE_HTTPS=true

# Opcional: panel en https://admin.example.com. Vacio conserva /admin.
ADMIN_DOMAIN=

# El despliegue demostrativo permanece en el entorno de prueba de Mercado Pago.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_MODE=test
MERCADOPAGO_ALLOW_LIVE=false
MERCADOPAGO_TEST_PUBLIC_KEY=
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_WEBHOOK_SECRET=

# Respaldo demostrativo sin servicios externos. Usa un secreto aleatorio >= 32 caracteres.
PAYMENT_SIMULATOR_ENABLED=false
PAYMENT_SIMULATOR_SECRET=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=devioz
DB_USERNAME=devioz
DB_PASSWORD=
DB_ROOT_PASSWORD=
MYSQL_ATTR_SSL_CA=

CACHE_DRIVER=file
FILESYSTEM_DISK=public
MEDIA_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Ejecutar migraciones al iniciar solo cuando el responsable del despliegue lo autorice.
RUN_MIGRATIONS=false

# Inicializacion demostrativa idempotente. Solo se activa de forma explicita.
RUN_DEMO_SEEDERS=false

# Copia opcional, no destructiva, desde un volumen publico hacia MEDIA_DISK.
RUN_MEDIA_COPY=false
MEDIA_COPY_FROM=public

# Solo para una demostracion de una instancia. En produccion se usa un worker separado.
RUN_SCHEDULER=false

SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudflare R2 (se activa estableciendo MEDIA_DISK=s3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary (recomendado para la demostracion sin tarjeta ni disco persistente).
# Activar con MEDIA_DISK=cloudinary. Las credenciales se cargan solo en el servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY_URL=
