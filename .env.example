APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FORCE_HTTPS=false

# Host opcional del panel (sin https://). Vacio mantiene /admin.
ADMIN_DOMAIN=

# Pasarela académica: mantener deshabilitada salvo en desarrollo o hosting demostrativo.
PAYMENT_SIMULATOR_ENABLED=false
PAYMENT_SIMULATOR_SECRET=

# Mercado Pago Checkout Pro: usar solo credenciales de prueba durante el desarrollo.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_MODE=test
MERCADOPAGO_ALLOW_LIVE=false
MERCADOPAGO_TEST_PUBLIC_KEY=
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_WEBHOOK_SECRET=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=devioz
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Solo para creación explícita del primer administrador. No uses credenciales de ejemplo.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudinary (alternativa sin disco persistente; establecer MEDIA_DISK=cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY_URL=

RUN_MIGRATIONS=false
RUN_DEMO_SEEDERS=false
RUN_MEDIA_COPY=false
MEDIA_COPY_FROM=public
RUN_SCHEDULER=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
